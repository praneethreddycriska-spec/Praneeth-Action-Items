{
  "rewrites": [
    { "source": "/sb/:path*", "destination": "https://cmiyphvjbczfafpcyvcq.supabase.co/:path*" },
    { "source": "/((?!assets/|sb/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/((?!assets/).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
